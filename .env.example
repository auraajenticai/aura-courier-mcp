# ==============================================================================
# Aura Courier MCP (v2.7.3) — Environment Variable Template (NO REAL SECRETS!)
# ==============================================================================
# PRODUCTION RULE:
# - NEVER commit a real `.env` file or bake `.env` into Docker images.
# - Generate every auth/OAuth/webhook secret with: `openssl rand -hex 32`
# - Store all production values in your secret manager / deployment environment.
# - Server FAILS CLOSED on startup if required secrets are missing or weak.
# ==============================================================================

# --- Server & Auth (ALL REQUIRED IN PRODUCTION — MIN 24 CHARS HIGH ENTROPY) ---
NODE_ENV=production
PORT=80
HOST=0.0.0.0
DATABASE_URL=postgresql://db_user:REPLACE_ME@db.internal:5432/aura_courier
AURA_API_KEY=<generate-with-openssl-rand-hex-32>
AURA_ADMIN_KEY=<generate-with-openssl-rand-hex-32>
AURA_READONLY_KEY=<generate-with-openssl-rand-hex-24>
AURA_WEBHOOK_SECRET=<generate-with-openssl-rand-hex-32>
AURA_OAUTH_SECRET=<generate-with-openssl-rand-hex-32>
AURA_SSO_JWT_SECRET=<generate-with-openssl-rand-hex-32>
# Optional comma-separated allowed browser origins (defaults to * for MCP clients)
# CORS_ORIGIN=https://client.example.com,https://admin.example.com

# --- Steadfast Courier ---
STEADFAST_API_KEY=your_steadfast_api_key
STEADFAST_SECRET_KEY=your_steadfast_secret_key
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1

# --- Pathao Express ---
PATHAO_CLIENT_ID=your_pathao_client_id
PATHAO_CLIENT_SECRET=your_pathao_client_secret
PATHAO_USERNAME=your_pathao_email
PATHAO_PASSWORD=your_pathao_password
PATHAO_STORE_ID=your_pathao_store_id
PATHAO_BASE_URL=https://api-hermes.pathao.com

# --- RedX Delivery ---
REDX_API_TOKEN=your_redx_jwt_token
REDX_BASE_URL=https://openapi.redx.com.bd/v1.0.0-beta
REDX_PICKUP_STORE_ID=your_redx_pickup_store_id

# --- Paperfly Go ---
PAPERFLY_API_KEY=your_paperfly_header_key
PAPERFLY_USERNAME=your_paperfly_username
PAPERFLY_PASSWORD=your_paperfly_password
PAPERFLY_STORE_NAME=your_store_name
PAPERFLY_BASE_URL=https://api.paperfly.com.bd

# --- Google Maps & Optional Bridges ---
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
# SNEHALATA_VERIFY_KEY_URL=https://your-store.example.com/api/mcp/verify-key
# SNEHALATA_WEBHOOK_URL=https://your-store.example.com/api/webhooks/pathao
